# GPlanSiS|Project — variáveis de ambiente (valores FICTÍCIOS de exemplo).
# Copie para .env e ajuste. Nunca versione o .env.

# Conexão da API (async) e das migrations (sync)
GPS_DSN=postgresql+asyncpg://gps:gps@127.0.0.1:5433/gplansis
GPS_DSN_SYNC=postgresql+psycopg://gps:gps@127.0.0.1:5433/gplansis

# Papel assumido em cada transação (SET LOCAL ROLE) para a RLS valer
GPS_DB_ROLE=gps_app

# Origens extras do frontend (separadas por vírgula); localhost em qualquer porta já é aceito
GPS_CORS_ORIGENS=https://project.exemplo.com

# 1 = aceita o cabeçalho X-Organizacao sem token (SÓ desenvolvimento/smokes antigos)
GPS_PERMITIR_HEADER_ORG=0

# Validade do token de sessão, em horas
GPS_SESSAO_HORAS=12

# Serviço systemd (deploy/vps/gpsproject.service)
GPS_PORT=8800
GPS_WORKERS=2

# Leitura de .mpp (MPXJ) — opcional
# JAVA_HOME=/usr/lib/jvm/default-java

# Scripts (bootstrap, demo e smokes)
GPS_DSN_SEED=postgresql://gps:gps@127.0.0.1:5433/gplansis
GPS_API=http://127.0.0.1:8001
GPS_ADMIN_EMAIL=admin@exemplo.com
GPS_ADMIN_SENHA=troque-esta-senha
